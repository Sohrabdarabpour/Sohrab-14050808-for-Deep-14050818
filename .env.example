# ============================================================
#  نمونه فایل متغیرهای محیطی
#  کپی کنید به .env و مقادیر واقعی را جایگذاری کنید:
#      copy .env.example .env
# ============================================================

# کلید نشست — حتماً یک مقدار تصادفی بگذارید:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=یک-کلید-تصادفی-امن

# SSPE_DATABASE_PATH=

# ---- اجرا ----
# debug به‌صورت پیش‌فرض خاموش است؛ فقط برای توسعه 1 کنید
FLASK_DEBUG=0
SSPE_HOST=127.0.0.1
SSPE_PORT=5000

# ---- کوکی نشست ----
# اگر سایت را پشت HTTPS اجرا می‌کنید، 1 بگذارید
SESSION_COOKIE_SECURE=0

# ---- تقویم کاری و مهلت پاسخ ----
# روزهای تعطیل هفتگی (ISO: دوشنبه=۱ … یکشنبه=۷). پیش‌فرض پنجشنبه و جمعه.
# اگر فقط جمعه تعطیل است: 5
SSPE_WEEKEND_DAYS=4,5
# مهلت پاسخ پیش‌فرض (روز کاری) وقتی گروه/زیرگروه مقداری ندارد
SSPE_DEFAULT_SLA_DAYS=7

# میزبان‌های اضافی مجاز برای درخواست‌های POST (پشت reverse proxy)، با کاما
# مثال: SSPE_TRUSTED_ORIGINS=sspe.example.com,10.0.0.5:5000
SSPE_TRUSTED_ORIGINS=

# ---- بخش هوش مصنوعی ----
LLM_PROVIDER=deepseek
LLM_ENABLED=true

# کلید API را از platform.deepseek.com بگیرید
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# سرویس واسط ایرانی (بدون نیاز به VPN)
AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_MODEL=gpt-5.4-mini

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

GROQ_API_KEY=
OPENAI_API_KEY=

LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
